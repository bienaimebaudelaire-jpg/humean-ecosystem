# HUMEAN Ecosystem environment template
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional local result path
HUMEAN_CAPABILITY_LOG=data/capability_log.json

# Self-hosted OmniRoute gateway (github.com/diegosouzapw/OmniRoute), read by
# humean_core.providers.omniroute_gateway. Optional: only needed for
# capabilities whose metadata declares a gateway_model.
ROUTECORE_OMNIROUTE_BASE_URL=
ROUTECORE_OMNIROUTE_API_KEY=
